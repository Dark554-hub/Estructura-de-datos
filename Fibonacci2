def fib_rec(n):
    # Recursivo (recursividad múltiple)
    if n <= 1:
        return n
    return fib_rec(n - 1) + fib_rec(n - 2)


def fib_iter(n):
    # Iterativo
    a, b = 0, 1
    for _ in range(n):
        a, b = b, a + b
    return a


n = int(input("¿Cuántos términos? "))

print("Recursivo:", *[fib_rec(i) for i in range(n)])
print("Iterativo:", *[fib_iter(i) for i in range(n)])
